{
  "name": "sorte-ar-server",
  "version": "0.1.0",
  "description": "Sorte.ar backend — user profiles and social features",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/app.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "bcrypt": "5.1.1",
    "cloudinary": "2.5.1",
    "dotenv": "16.4.7",
    "drizzle-kit": "0.31.0",
    "drizzle-orm": "0.41.0",
    "express": "5.0.1",
    "express-rate-limit": "7.5.0",
    "ioredis": "5.4.2",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.2",
    "pg": "8.13.3",
    "resend": "4.0.0",
    "tsx": "4.19.3",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/jsonwebtoken": "9.0.9",
    "@types/multer": "1.4.12",
    "@types/node": "22.15.3",
    "@types/pg": "8.11.13",
    "@vitest/coverage-v8": "3.1.3",
    "eslint": "9.26.0",
    "fast-check": "3.23.2",
    "typescript": "5.8.3",
    "vitest": "3.1.3"
  }
}
