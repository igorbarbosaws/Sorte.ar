# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sorte_ar

# JWT
JWT_SECRET=replace-with-a-long-random-secret-at-least-64-chars
JWT_ACCESS_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (Resend)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Sorte.ar <onboarding@resend.dev>

# App
APP_URL=https://sorte-ar.vercel.app
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:8080
